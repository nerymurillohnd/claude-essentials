{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/nerymurillohnd/claude-essentials/schemas/claude-code/mcp.schema.json",
  "title": "Claude Code .mcp.json",
  "description": "Complete skeleton of a .mcp.json file (plugin root or project root). Mirrors the official MCP reference; no repo-specific policy. The server map is also the inline form of plugin.json mcpServers.",
  "$comment": "Sources: https://code.claude.com/docs/en/mcp, https://code.claude.com/docs/en/mcp-quickstart, https://code.claude.com/docs/en/plugins-reference#mcp-servers (verified 2026-09-18 against Claude Code 2.1.277). The transport key is `type`. Inside plugins, ${CLAUDE_PLUGIN_ROOT}, ${CLAUDE_PLUGIN_DATA}, ${CLAUDE_PROJECT_DIR} and ${user_config.KEY} are substituted; ${VAR} and ${VAR:-default} expand from the environment.",
  "type": "object",
  "additionalProperties": false,
  "required": ["mcpServers"],
  "properties": {
    "$schema": { "type": "string" },
    "mcpServers": { "$ref": "#/definitions/serverMap" }
  },
  "definitions": {
    "serverMap": {
      "type": "object",
      "description": "MCP servers keyed by server name.",
      "additionalProperties": { "$ref": "#/definitions/server" }
    },
    "server": {
      "oneOf": [
        { "$ref": "#/definitions/stdioServer" },
        { "$ref": "#/definitions/httpServer" },
        { "$ref": "#/definitions/wsServer" }
      ]
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "timeout": {
      "type": "number",
      "description": "Milliseconds per tool call; applies at 1000 ms or more."
    },
    "alwaysLoad": {
      "type": "boolean",
      "description": "Default false."
    },
    "stdioServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command"],
      "properties": {
        "type": {
          "const": "stdio",
          "description": "Optional for stdio (the default transport)."
        },
        "command": { "type": "string", "minLength": 1 },
        "args": { "type": "array", "items": { "type": "string" } },
        "env": { "$ref": "#/definitions/stringMap" },
        "cwd": { "type": "string" },
        "timeout": { "$ref": "#/definitions/timeout" },
        "alwaysLoad": { "$ref": "#/definitions/alwaysLoad" }
      }
    },
    "httpServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": {
          "enum": ["http", "streamable-http", "sse"],
          "description": "streamable-http is an alias of http."
        },
        "url": { "type": "string" },
        "headers": { "$ref": "#/definitions/stringMap" },
        "headersHelper": {
          "type": "string",
          "description": "Command that prints headers as a JSON object."
        },
        "oauth": { "$ref": "#/definitions/oauth" },
        "env": { "$ref": "#/definitions/stringMap" },
        "timeout": { "$ref": "#/definitions/timeout" },
        "alwaysLoad": { "$ref": "#/definitions/alwaysLoad" }
      }
    },
    "wsServer": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "url"],
      "properties": {
        "type": { "const": "ws" },
        "url": { "type": "string" },
        "headers": { "$ref": "#/definitions/stringMap" },
        "headersHelper": { "type": "string" },
        "env": { "$ref": "#/definitions/stringMap" },
        "timeout": { "$ref": "#/definitions/timeout" },
        "alwaysLoad": { "$ref": "#/definitions/alwaysLoad" }
      }
    },
    "oauth": {
      "type": "object",
      "additionalProperties": false,
      "description": "http/sse only.",
      "properties": {
        "clientId": { "type": "string" },
        "callbackPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Fixed OAuth callback port; random when omitted."
        },
        "authServerMetadataUrl": {
          "type": "string",
          "description": "Authorization server metadata URL."
        },
        "scopes": {
          "type": "string",
          "description": "Space-separated OAuth scopes."
        }
      }
    }
  }
}
