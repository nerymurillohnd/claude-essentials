{
  "permissions": {
    "ask": [
      "Bash(git push *)",
      "Bash(git remote add *)",
      "Bash(git remote set-url *)",
      "Bash(gh pr create *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "Bash(gh release delete *)",
      "Bash(gh release upload *)",
      "Bash(gh repo create *)",
      "Bash(gh repo edit *)",
      "Bash(gh repo delete *)",
      "Bash(gh label create *)",
      "Bash(gh label edit *)",
      "Bash(gh label delete *)",
      "Bash(gh workflow run *)",
      "Bash(claude plugin tag *--push*)",
      "mcp__github__create_*",
      "mcp__github__merge_*",
      "mcp__github__push_*",
      "mcp__github__update_*",
      "mcp__github__delete_*",
      "mcp__github__fork_*",
      "mcp__github__add_*",
      "mcp__github__*_write",
      "mcp__github__request_copilot_review"
    ],
    "deny": [
      "Bash(git commit *--no-gpg-sign*)",
      "Bash(git commit *--no-verify*)",
      "Bash(git -c commit.gpgsign=false *)",
      "Bash(git -c tag.gpgsign=false *)",
      "Bash(git push *--force*)"
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py",
              "session-status"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py",
              "guard-bash"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py",
              "guard-edit"
            ],
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "^(Read|Grep|Glob|LSP|Bash|Edit|Write|WebFetch)$|^mcp__github__",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": [
              "${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py",
              "guard-sources"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/scripts/claude_hooks.py", "format"],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
