{
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "permissions": {
    "allow": [
      "Bash(make *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(.venv/bin/python -m scripts.*)",
      "Bash(.venv/bin/pytest*)",
      "Bash(.venv/bin/ruff*)",
      "Bash(.venv/bin/basedpyright*)",
      "Bash(claude plugin validate *)",
      "Bash(claude plugin list *)",
      "Bash(claude plugin details *)",
      "Bash(claude plugin marketplace list *)",
      "mcp__ide__getDiagnostics"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/bash-stamp.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "repo-auditor",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/record-audit.sh",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "head"
  },
  "enableWorkflows": true,
  "enabledPlugins": {
    "plugin-dev@claude-plugins-official": true,
    "basedpyright@claude-code-lsps": true,
    "bash-language-server@claude-code-lsps": true
  },
  "todoFeatureEnabled": true
}
