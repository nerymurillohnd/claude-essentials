{
  "version": "2.0.0",
  "inputs": [
    {
      "id": "plugin",
      "type": "pickString",
      "description": "Plugin to evaluate",
      "options": [
        "agent-self-knowledge",
        "block-no-verify",
        "ruff-quality",
        "shell-quality",
        "verify-completion"
      ]
    }
  ],
  "tasks": [
    {
      "label": "setup",
      "type": "shell",
      "command": "make",
      "args": [
        "setup"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "check",
      "type": "shell",
      "command": "make",
      "args": [
        "check"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "generate",
      "type": "shell",
      "command": "make",
      "args": [
        "generate"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "lint",
      "type": "shell",
      "command": "make",
      "args": [
        "lint"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "lint-staged",
      "type": "shell",
      "command": "make",
      "args": [
        "lint-staged"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "types",
      "type": "shell",
      "command": "make",
      "args": [
        "types"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test-fast",
      "type": "shell",
      "command": "make",
      "args": [
        "test-fast"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "validate",
      "type": "shell",
      "command": "make",
      "args": [
        "validate"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "validate-cli",
      "type": "shell",
      "command": "make",
      "args": [
        "validate-cli"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "test-slow",
      "type": "shell",
      "command": "make",
      "args": [
        "test-slow"
      ],
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "versions",
      "type": "shell",
      "command": "make",
      "args": [
        "versions"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "versions (json)",
      "type": "shell",
      "command": "make",
      "args": [
        "versions",
        "VERSIONS_ARGS=--json"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "fix",
      "type": "shell",
      "command": "make",
      "args": [
        "fix"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "fix-file",
      "type": "shell",
      "command": "make",
      "args": [
        "fix-file",
        "FILE=${relativeFile}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "clean",
      "type": "shell",
      "command": "make",
      "args": [
        "clean"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "help",
      "type": "shell",
      "command": "make",
      "args": [
        "help"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "eval this plugin",
      "type": "shell",
      "command": "claude",
      "args": [
        "plugin",
        "eval",
        "plugins/${input:plugin}",
        "--ablation",
        "with-without",
        "--allow-tools",
        "Bash",
        "Write",
        "Edit",
        "WebFetch",
        "--model",
        "claude-sonnet-5",
        "--judge-model",
        "claude-opus-5",
        "--no-publish",
        "--max-cost-usd",
        "12"
      ],
      "group": "test",
      "problemMatcher": []
    }
  ]
}
