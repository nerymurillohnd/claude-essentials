{
  "$schema": "https://unpkg.com/knip@6/schema.json",

  // Private, self-contained repo (package.json "private": true, nothing published):
  // an unused export in an entry script is dead code too.
  "includeEntryExports": true,

  // A configuration hint means Knip's picture of the repo is wrong: fail on it.
  "treatConfigHintsAsErrors": true,

  // Entries come from Knip's own plugins (package.json scripts, node:test,
  // GitHub Actions workflows, Biome, TypeScript), so none are listed here: a
  // redundant entry would itself be a configuration hint.
  //
  // Not configured on purpose:
  // - Production mode (--production/--strict): every script here is maintainer
  //   tooling; plugins ship Markdown/JSON, not bundled code.
  // - `workspaces`: add "plugins/<id>" only when a plugin ships Node code with its
  //   own package.json, together with its `entry` (Knip can't infer an MCP server
  //   entry from .mcp.json). Declaring a glob that matches no package.json is a
  //   configuration hint.
  // - Catalogs: npm has none.

  // Plugin workflow scripts are loaded by Claude Code (/<plugin>:<name>), not
  // imported by anything here, so they are entries like an MCP server's.
  "entry": ["plugins/*/workflows/*.js"],
  // Their `export const meta` is read by that runtime, and a workflow script must
  // begin with it, so there's no room for a `@public` tag: skip only the unused-
  // export check, only for these files.
  "ignoreIssues": { "plugins/*/workflows/*.js": ["exports"] },

  // Accepted by the maintainer (2026-09-18): pinned to match the global binary.
  // Claude Code's typescript-lsp plugin runs typescript-language-server from PATH,
  // so nothing in this repo imports or executes it — Knip is right that it's unused.
  //
  // Accepted by the maintainer (2026-09-19): @knip/mcp is the Knip MCP server
  // Claude Code starts from .mcp.json (`npx --no-install knip-mcp`), so nothing
  // imports it. It's pinned here so it runs the repo's own knip (deduped;
  // scripts/lib/tooling-alignment.test.mjs fails if that ever changes).
  "ignoreDependencies": ["typescript-language-server", "@knip/mcp"]
}
