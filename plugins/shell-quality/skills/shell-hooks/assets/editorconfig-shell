# >>> shell-quality recommended shfmt style >>>
# [[shell]] is shfmt's language section: it matches every shell script,
# including extensionless ones with a shell shebang and .bats files. The style
# follows the Google Shell Style Guide (shfmt -i 2 -ci -bn -s).
[[shell]]
indent_style = space
indent_size = 2
switch_case_indent = true
binary_next_line = true
simplify = true
# <<< shell-quality recommended shfmt style <<<
