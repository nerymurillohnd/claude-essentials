{
  "svelte": {
    "command": "svelteserver",
    "args": ["--stdio"],
    "extensionToLanguage": {
      ".svelte": "svelte"
    },
    "workspaceFolder": "${CLAUDE_PROJECT_DIR}",
    "startupTimeout": 30000,
    "shutdownTimeout": 10000,
    "requestTimeout": 60000,
    "restartOnCrash": true,
    "maxRestarts": 3,
    "diagnostics": true
  }
}
