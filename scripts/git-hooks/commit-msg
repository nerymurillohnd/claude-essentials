#!/usr/bin/env python3
"""Optional git commit-msg hook: rejects messages that break Conventional Commits.

Install it in your clone (Set up in docs/testing.md):
  cp scripts/git-hooks/commit-msg .git/hooks/commit-msg
It runs the same checker CI runs on every commit.
"""

from pathlib import Path
import subprocess
import sys


def main() -> int:
    """Check the commit message file git passes as the first argument."""
    # git runs a hook from the root of the working tree (`git help githooks`),
    # so the checker path is relative to the current directory.
    checker = Path.cwd() / "scripts" / "check_commit_msg.py"
    return subprocess.call([sys.executable, str(checker), "--file", sys.argv[1]])


if __name__ == "__main__":
    sys.exit(main())
