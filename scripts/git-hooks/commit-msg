#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.12"
# dependencies = []
# ///
"""Optional git commit-msg hook: rejects messages that break Conventional Commits.

Install it in your clone (docs/contributing-setup in CONTRIBUTING.md):
  cp scripts/git-hooks/commit-msg .git/hooks/commit-msg
It runs the same checker CI runs on pull requests.
"""

import subprocess
import sys
from pathlib import Path


def main() -> int:
    top = subprocess.run(
        ["git", "rev-parse", "--show-toplevel"],
        check=True,
        capture_output=True,
        text=True,
    ).stdout.strip()
    checker = Path(top) / "scripts" / "check_commit_msg.py"
    return subprocess.call(["uv", "run", str(checker), "--file", sys.argv[1]])


if __name__ == "__main__":
    sys.exit(main())
