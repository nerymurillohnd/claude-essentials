{
  "name": "claude-essentials",
  "version": "0.0.0",
  "private": true,
  "description": "A public marketplace of Claude Code plugins, skills, and agents — install via /plugin marketplace add nerymurillohnd/claude-essentials.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "biome:check": "biome check . --max-diagnostics=none --error-on-warnings",
    "biome:ci": "biome ci . --max-diagnostics=none --error-on-warnings",
    "biome:fix": "biome check . --write --max-diagnostics=none",
    "biome:fix:unsafe": "biome check . --write --unsafe --max-diagnostics=none",
    "biome:staged": "biome check --staged --no-errors-on-unmatched --max-diagnostics=none --error-on-warnings",
    "biome:watch": "biome check . --watch --max-diagnostics=none --error-on-warnings",
    "check": "npm run biome:ci && npm run lint:sh && npm run typecheck && npm run knip && npm test && npm run generate && npm run validate && npm run validate:claude",
    "check:versions": "node scripts/check-versions.mjs",
    "format": "biome format . --max-diagnostics=none",
    "format:fix": "biome format . --write --max-diagnostics=none",
    "generate": "node scripts/generate-marketplace.mjs && node scripts/generate-issue-forms.mjs",
    "knip": "knip",
    "labels:sync": "node scripts/sync-labels.mjs",
    "lint": "biome lint . --max-diagnostics=none --error-on-warnings",
    "lint:fix": "biome lint . --write --max-diagnostics=none",
    "lint:sh": "node scripts/lint-shell.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "validate": "node scripts/validate-marketplace.mjs",
    "validate:claude": "node scripts/validate-claude.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@knip/mcp": "0.0.36",
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "knip": "6.37.0",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.0",
    "yaml": "^2.9.1"
  }
}
