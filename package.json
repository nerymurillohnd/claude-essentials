{
  "name": "claude-essentials",
  "version": "0.0.0",
  "private": true,
  "description": "A public marketplace of Claude Code plugins, skills, and agents — install via /plugin marketplace add nerymurillohnd/claude-essentials.",
  "type": "module",
  "license": "Apache-2.0",
  "scripts": {
    "generate": "node scripts/generate-marketplace.mjs && node scripts/generate-issue-forms.mjs",
    "validate": "node scripts/validate-marketplace.mjs",
    "validate:claude": "node scripts/validate-claude.mjs",
    "check:versions": "node scripts/check-versions.mjs",
    "labels:sync": "node scripts/sync-labels.mjs",
    "test": "node --test \"scripts/**/*.test.mjs\"",
    "format": "biome format --write .",
    "lint": "biome lint .",
    "lint:sh": "node scripts/lint-shell.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "check": "biome check . && npm run lint:sh && npm run typecheck && npm test && npm run generate && npm run validate && npm run validate:claude"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "24.13.6",
    "@types/semver": "7.8.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "semver": "^7.8.5",
    "typescript": "6.0.3",
    "typescript-language-server": "6.0.0",
    "yaml": "^2.9.1"
  }
}
